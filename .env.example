# SIHOA configuration. Copy this file to .env (next to it, in the repository root) and adjust the values.
# The systemd service loads .env; sihoa.py also accepts the same settings as command line flags, which win.
# Format: KEY=value, one per line, no "export". Leave a value empty to use the default.

# SQLite database file (relative paths are relative to the repository root)
SIHOA_DATABASE=test.sqlite

# Application log file (rotated at 5 MB, 15 backups). Empty: log to stderr, which ends up in journalctl -u sihoa
SIHOA_LOG_FILE=logs/sihoa.log

# MQTT broker (Mosquitto on the Pi)
SIHOA_MQTT_HOST=localhost
SIHOA_MQTT_PORT=1883
# Credentials are only used when both are set
SIHOA_MQTT_USERNAME=
SIHOA_MQTT_PASSWORD=
